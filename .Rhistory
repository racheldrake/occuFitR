p = p_sim$statistic
)
)
}
# --- bootstrap ---
boot_results <- future.apply::future_replicate(
n_boot,
sim_once(),
simplify = FALSE
)
# collect aggregate statistics
boot_stats <- do.call(
rbind,
lapply(
boot_results,
function(x) x$statistic
)
)
boot_stats <- as.data.frame(boot_stats)
# --- p-values ---
p_values <- c(
mb = mean(
boot_stats$mb >= T_obs["mb"],
na.rm = TRUE
),
psi_p = mean(
boot_stats$psi_p >= T_obs["psi_p"],
na.rm = TRUE
),
p = mean(
boot_stats$p >= T_obs["p"],
na.rm = TRUE
)
)
structure(
list(
fit = fit,
statistic = T_obs,
p_value = p_values,
bootstrap = boot_stats,
residuals = true_residuals,
site_covs = site_covs,
n_boot = n_boot
),
class = "occu_gof"
)
}
predictions <- .get_occu_predictions(fit)
all.equal(
mb_stat(fit),
mb_stat(fit, predictions),
tolerance = 1e-10
)
all.equal(
psi_p_stat(fit),
psi_p_stat(fit, predictions),
tolerance = 1e-10
)
all.equal(
p_stat(fit),
p_stat(fit, predictions),
tolerance = 1e-10
)
compare_gof <- function(fit, n_boot = 100, seed = 123,
tolerance = 1e-10) {
old <- occu_gof(fit, n_boot = n_boot, seed = seed)
new <- occu_gof_fast(fit, n_boot = n_boot, seed = seed)
components <- c(
"statistic",
"p_value",
"bootstrap",
"residuals",
"site_covs",
"n_boot"
)
results <- lapply(components, function(x) {
a <- old[[x]]
b <- new[[x]]
data.frame(
component = x,
identical = identical(a, b),
numerically_equal = isTRUE(
all.equal(a, b, tolerance = tolerance)
)
)
})
list(
comparison = do.call(rbind, results),
original = old,
fast = new
)
}
compare_gof(fit = fit)
bench::mark(
original = occu_gof(fit, n_boot = 100, seed = 123),
fast = occu_gof_fast(fit, n_boot = 100, seed = 123),
iterations = 5,
check = FALSE
)
bench::mark(
original = occu_gof(fit, n_boot = 10, seed = 123),
fast = occu_gof_fast(fit, n_boot = 10, seed = 123),
iterations = 5,
check = FALSE
)
#' Parametric bootstrap goodness-of-fit tests for occupancy models
#'
#' Performs parametric bootstrap goodness-of-fit (GOF) tests for a fitted
#' single-season occupancy model. Simulated detection histories are generated
#' using the fitted occupancy and detection probabilities, while retaining
#' the observed pattern of missing visits. The model is refitted to each
#' simulated dataset and the GOF statistics recalculated.
#'
#' Three aggregate GOF statistics are calculated: the MacKenzie-Bailey (MB)
#' statistic, a site-level occupancy and detection probability (\eqn{\psi-p})
#' statistic, and a detection probability (\eqn{p}) statistic. Bootstrap
#' p-values are calculated as the proportion of simulated statistics greater
#' than or equal to the corresponding observed statistic.
#'
#' Site-level residuals are also calculated for the \eqn{\psi-p} and
#' \eqn{p} statistics, allowing further investigation of model fit using
#' covariates or spatial information.
#'
#' @param fit A fitted occupancy model of class \code{unmarkedFitOccu}.
#' @param n_boot Number of parametric bootstrap replicates. Defaults to
#'   \code{1000}.
#' @param seed Optional random seed for reproducibility. If \code{NULL},
#'   no seed is set.
#'
#' @return An object of class \code{occu_gof}, containing:
#' \describe{
#'   \item{fit}{The original fitted occupancy model.}
#'   \item{statistic}{A named vector of the observed MB, \eqn{\psi-p}, and
#'   \eqn{p} GOF statistics.}
#'   \item{p_value}{A named vector of bootstrap p-values for the three
#'   GOF statistics.}
#'   \item{bootstrap}{A data frame containing the simulated values of
#'   each GOF statistic across bootstrap replicates.}
#'   \item{residuals}{A list containing data frames of observed site-level
#'   residuals for the \eqn{\psi-p} and \eqn{p} statistics, including
#'   the corresponding site indices.}
#'   \item{site_covs}{A data frame containing the site-level covariates
#'   from the original occupancy model, including site indices.}
#'   \item{n_boot}{The number of bootstrap replicates performed.}
#' }
#'
#' @details
#' For each bootstrap replicate, occupancy states are simulated using the
#' fitted site-level occupancy probabilities. Detection histories are then
#' simulated using the fitted detection probabilities, conditional on
#' occupancy. The observed pattern of missing visits is retained.
#'
#' The occupancy model is refitted to each simulated dataset before the
#' GOF statistics are recalculated. The resulting bootstrap distributions
#' are compared with the observed statistics to obtain upper-tail p-values.
#'
#' The \eqn{\psi-p} residuals are calculated for all sites, whereas
#' the \eqn{p} residuals are calculated only for sites where the species
#' was detected.
#'
#' @seealso
#' \code{\link[unmarked:occu]{unmarked::occu}},
#' \code{\link[unmarked:getY]{unmarked::getY}},
#' \code{\link{summary.occu_gof}},
#' \code{\link{plot_bootstrap}},
#' \code{\link{plot_residuals}},
#' \code{\link{plot_spatial_residuals}}
#'
#' @examples
#' \dontrun{
#'   fit <- unmarked::occu(~ 1 ~ 1, data = umf)
#'
#'   gof <- occu_gof(
#'     fit,
#'     n_boot = 1000,
#'     seed = 123
#'   )
#'
#'   summary(gof)
#' }
#'
#' @export
occu_gof <- function(fit, n_boot = 1000, seed = NULL) {
if (!is.null(seed)) set.seed(seed)
y <- unmarked::getY(fit)
n_sites <- nrow(y)
n_visits <- ncol(y)
# --- model predictions ---
predictions <- .get_occu_predictions(fit)
psi_hat <- predictions$psi
p_mat <- predictions$p_mat
# --- observed data stats ---
mb_obs <- mb_stat(fit, predictions)
psi_p_obs <- psi_p_stat(fit, predictions)
p_obs <- p_stat(fit, predictions)
T_obs <- c(
mb = mb_obs$statistic,
psi_p = psi_p_obs$statistic,
p = p_obs$statistic
)
# --- save true site-level residuals ---
p_sites <- which(
rowSums(y, na.rm = TRUE) > 0
)
true_residuals <- list(
psi_p = data.frame(
site = seq_len(n_sites),
residual = psi_p_obs$residuals
),
p = data.frame(
site = p_sites,
residual = p_obs$residuals
)
)
# --- save site-level covariates ---
site_covs <- as.data.frame(siteCovs(fit@data))
# Ensure there is one row per site, including when
# the model has no site-level covariates
if (nrow(site_covs) == 0L) {
site_covs <- data.frame(row.names = seq_len(n_sites))
}
site_covs$site <- seq_len(n_sites)
# --- simulation function ---
sim_once <- function() {
y_sim <- matrix(NA, n_sites, n_visits)
for (i in seq_len(n_sites)) {
# Generate occupancy state from site psi
z <- rbinom(1, 1, psi_hat[i])
# Decide if we generate detections
if (z == 1) {
# generate detections for each visit
# where we have an observation
for (t in seq_len(n_visits)) {
if (!is.na(y[i, t])) {
y_sim[i, t] <- rbinom(
1,
1,
p_mat[i, t]
)
}
}
} else {
for (t in seq_len(n_visits)) {
# also need to include missing-ness here
if (!is.na(y[i, t])) {
y_sim[i, t] <- 0
}
}
}
}
# fit model to generated data
umf_sim <- unmarkedFrameOccu(
y = y_sim,
siteCovs = siteCovs(fit@data),
obsCovs = obsCovs(fit@data)
)
fit_sim <- update(fit, data = umf_sim)
predictions_sim <- .get_occu_predictions(fit_sim)
mb_sim <- mb_stat(fit_sim, predictions_sim)
psi_p_sim <- psi_p_stat(fit_sim, predictions_sim)
p_sim <- p_stat(fit_sim, predictions_sim)
# arrange outputs
list(
# aggregate GOF statistics
statistic = c(
mb = mb_sim$statistic,
psi_p = psi_p_sim$statistic,
p = p_sim$statistic
)
)
}
# --- bootstrap ---
boot_results <- future.apply::future_replicate(
n_boot,
sim_once(),
simplify = FALSE
)
# collect aggregate statistics
boot_stats <- do.call(
rbind,
lapply(
boot_results,
function(x) x$statistic
)
)
boot_stats <- as.data.frame(boot_stats)
# --- p-values ---
p_values <- c(
mb = mean(
boot_stats$mb >= T_obs["mb"],
na.rm = TRUE
),
psi_p = mean(
boot_stats$psi_p >= T_obs["psi_p"],
na.rm = TRUE
),
p = mean(
boot_stats$p >= T_obs["p"],
na.rm = TRUE
)
)
structure(
list(
fit = fit,
statistic = T_obs,
p_value = p_values,
bootstrap = boot_stats,
residuals = true_residuals,
site_covs = site_covs,
n_boot = n_boot
),
class = "occu_gof"
)
}
devtools::load_all()
# Use sequential execution so the profiler can see
# the work done inside the bootstrap replicates
old_plan <- future::plan()
future::plan(future::sequential)
profvis::profvis({
gof <- occu_gof(
fit,
n_boot = 20,
seed = 123
)
})
future::plan(old_plan)
mb_stat <- function(fit, predictions = NULL) {
y <- unmarked::getY(fit)
n_sites <- nrow(y)
n_visits <- ncol(y)
# Model predictions
if (is.null(predictions)) {
predictions <- .get_occu_predictions(fit)
}
psi_hat <- predictions$psi
p_mat <- predictions$p_mat
p_mat <- matrix(
det_hat,
nrow = n_sites,
ncol = n_visits,
byrow = TRUE
)
# Observed histories
obs_hist <- apply(
y,
1,
function(x) paste(ifelse(is.na(x), ".", x), collapse = "")
)
obs_counts <- table(obs_hist)
# Missing-data patterns
patterns <- unique(gsub("[01]", "x", obs_hist))
expected_counts <- numeric()
for (pattern in patterns) {
fixed <- strsplit(pattern, "")[[1]]
x_pos <- which(fixed == "x")
# Enumerate histories
if (length(x_pos) == 0) {
histories <- pattern
} else {
combos <- expand.grid(
rep(list(c("0", "1")), length(x_pos))
)
histories <- apply(combos, 1, function(z) {
h <- fixed
h[x_pos] <- z
paste(h, collapse = "")
})
}
site_ids <- which(gsub("[01]", "x", obs_hist) == pattern)
# Extract probabilities for sites in this pattern
psi <- psi_hat[site_ids]
p <- p_mat[site_ids, , drop = FALSE]
# Only use visits that are observed for this pattern
observed_pos <- which(fixed != ".")
p <- p[, observed_pos, drop = FALSE]
for (hist in histories) {
h <- as.integer(strsplit(hist, "")[[1]][observed_pos])
# Probability of this history conditional on occupancy
prob_occ <- apply(
ifelse(
matrix(h, nrow = length(site_ids), ncol = length(h), byrow = TRUE) == 1,
p,
1 - p
),
1,
prod
)
# Add probability of being unoccupied
prob_unocc <- if (all(h == 0)) 1 - psi else rep(0, length(psi))
expected_counts[hist] <- sum(psi * prob_occ + prob_unocc)
}
}
# Statistic
obs_all <- table(
factor(obs_hist, levels = names(expected_counts))
)
exp_all <- expected_counts
T_obs <- sum(
(obs_all - exp_all)^2 / exp_all,
na.rm = TRUE
)
list(
statistic = T_obs,
observed = obs_all,
expected = exp_all
)
}
devtools::load_all()
# Use sequential execution so the profiler can see
# the work done inside the bootstrap replicates
old_plan <- future::plan()
future::plan(future::sequential)
profvis::profvis({
gof <- occu_gof(
fit,
n_boot = 20,
seed = 123
)
})
future::plan(old_plan)
