Package: occuFitR
Title: Goodness of Fit Tests for Occupancy Models
Version: 0.0.0.9000
Authors@R: c(
    person("Rachel", "Drake", , "rld3@st-andrews.ac.uk", role = c("aut", "cre")),
    person("Alison", "Johnston", , "alison.johnston@st-andrews.ac.uk", role = "aut"),
    person("Ben", "Stevenson", , "ben.stevenson@st-andrews.ac.uk", role = "aut"),
    person("David", "Borchers", , "dlb@st-andrews.ac.uk", role = "aut")
